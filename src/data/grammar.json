    {
      "id": "patterns",
      "label": "Cấu trúc câu",
      "icon": "📐",
      "color": "#c084fc",
      "items": [
        {
          "id": "pat1",
          "pattern": "〜は〜です",
          "meaning": "A là B",
          "level": "Cơ bản",
          "color": "#22d3ee",
          "explanation": "Cấu trúc câu đơn giản nhất. Dùng để định nghĩa, giới thiệu. Phủ định: ではありません (hoặc じゃありません thân mật hơn).",
          "examples": [
            {
              "jp": "わたし<は> がくせい <です>。",
              "vn": "Tôi là học sinh.",
              "highlights": [
                "は",
                "です"
              ]
            },
            {
              "jp": "これ<は> ほん <です>。",
              "vn": "Đây là sách.",
              "highlights": [
                "は",
                "です"
              ]
            },
            {
              "jp": "やまださん<は> せんせい <です>。",
              "vn": "Anh Yamada là giáo viên.",
              "highlights": [
                "は",
                "です"
              ]
            }
          ]
        },
        {
          "id": "pat2",
          "pattern": "〜が あります / います",
          "meaning": "Có (tồn tại)",
          "level": "Cơ bản",
          "color": "#34d399",
          "explanation": "あります dùng cho vật vô tri. います dùng cho người và động vật. Phủ định: ありません / いません.",
          "examples": [
            {
              "jp": "つくえのうえ<に> ほん<が> あります。",
              "vn": "Trên bàn có sách.",
              "highlights": [
                "に",
                "が"
              ]
            },
            {
              "jp": "へや<に> ねこ<が> います。",
              "vn": "Trong phòng có mèo.",
              "highlights": [
                "に",
                "が"
              ]
            },
            {
              "jp": "ここ<に> ATM<が> ありますか？",
              "vn": "Ở đây có ATM không?",
              "highlights": [
                "に",
                "が"
              ]
            }
          ]
        },
        {
          "id": "pat3",
          "pattern": "〜たいです",
          "meaning": "Muốn làm gì",
          "level": "Trung bình",
          "color": "#f97316",
          "explanation": "Ghép: [động từ thể ます bỏ ます] + たい + です. Dùng tân ngữ với を hoặc が đều được.",
          "examples": [
            {
              "jp": "にほん<に> いき<たいです>。",
              "vn": "Tôi muốn đến Nhật Bản.",
              "highlights": [
                "に",
                "たいです"
              ]
            },
            {
              "jp": "すし<を> たべ<たいです>。",
              "vn": "Tôi muốn ăn sushi.",
              "highlights": [
                "を",
                "たいです"
              ]
            },
            {
              "jp": "にほんご<を> はなし<たいです>。",
              "vn": "Tôi muốn nói được tiếng Nhật.",
              "highlights": [
                "を",
                "たいです"
              ]
            }
          ]
        },
        {
          "id": "pat4",
          "pattern": "〜てください",
          "meaning": "Hãy làm gì (yêu cầu lịch sự)",
          "level": "Trung bình",
          "color": "#f472b6",
          "explanation": "Ghép: [động từ thể て] + ください. Để yêu cầu lịch sự. Thêm 〜ないで trước ください để cấm nhẹ nhàng.",
          "examples": [
            {
              "jp": "ゆっくり はなし<てください>。",
              "vn": "Hãy nói chậm thôi.",
              "highlights": [
                "てください"
              ]
            },
            {
              "jp": "ここに かい<てください>。",
              "vn": "Hãy viết vào đây.",
              "highlights": [
                "てください"
              ]
            },
            {
              "jp": "まっすぐ いっ<てください>。",
              "vn": "Hãy đi thẳng.",
              "highlights": [
                "てください"
              ]
            }
          ]
        },
        {
          "id": "pat5",
          "pattern": "〜ましょう / 〜ませんか",
          "meaning": "Hãy cùng... / Có muốn... không?",
          "level": "Trung bình",
          "color": "#a78bfa",
          "explanation": "ましょう: đề nghị cùng làm (mạnh hơn). ませんか: mời mọc lịch sự, mang tính hỏi ý kiến hơn.",
          "examples": [
            {
              "jp": "いっしょに いき<ましょう>！",
              "vn": "Hãy cùng đi nào!",
              "highlights": [
                "ましょう"
              ]
            },
            {
