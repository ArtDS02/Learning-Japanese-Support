  },
  "categories": [
    {
      "id": "particles",
      "label": "Trợ từ (Particles)",
      "icon": "⚡",
      "color": "#facc15",
      "items": [
        {
          "id": "p_wa",
          "particle": "は",
          "romaji": "wa",
          "function": "Đánh dấu chủ đề câu",
          "color": "#facc15",
          "detail": "は đánh dấu chủ đề mà câu nói xoay quanh. Khác với が (chủ ngữ hành động), は mang tính giới thiệu chủ đề.",
          "examples": [
            {
              "jp": "わたし<は>がくせいです。",
              "romaji": "Watashi <wa> gakusei desu.",
              "vn": "Tôi là học sinh.",
              "highlight": "は"
            },
            {
              "jp": "これ<は>ほんです。",
              "romaji": "Kore <wa> hon desu.",
              "vn": "Đây là sách.",
              "highlight": "は"
            }
          ]
        },
        {
          "id": "p_ga",
          "particle": "が",
          "romaji": "ga",
          "function": "Đánh dấu chủ ngữ / Nhấn mạnh",
          "color": "#f87171",
          "detail": "が chỉ rõ AI HOẶC CÁI GÌ thực hiện hành động. Thường dùng khi hỏi/trả lời câu hỏi 'ai?', 'cái gì?' hoặc nhấn mạnh.",
          "examples": [
            {
              "jp": "だれ<が>きましたか？",
              "romaji": "Dare <ga> kimashita ka?",
              "vn": "Ai đã đến?",
              "highlight": "が"
            },
            {
              "jp": "わたし<が>やります！",
              "romaji": "Watashi <ga> yarimasu!",
              "vn": "Tôi (chứ không ai khác) sẽ làm!",
              "highlight": "が"
            }
          ]
        },
        {
          "id": "p_wo",
          "particle": "を",
          "romaji": "wo / o",
          "function": "Đánh dấu tân ngữ trực tiếp",
          "color": "#34d399",
          "detail": "を đứng sau danh từ là tân ngữ chịu tác động của động từ. Phát âm là 'o' trong hội thoại hiện đại.",
          "examples": [
            {
              "jp": "みず<を>のみます。",
              "romaji": "Mizu <wo> nomimasu.",
              "vn": "Uống nước.",
              "highlight": "を"
            },
            {
              "jp": "にほんご<を>べんきょうします。",
              "romaji": "Nihongo <wo> benkyō shimasu.",
              "vn": "Học tiếng Nhật.",
              "highlight": "を"
            }
          ]
        },
        {
          "id": "p_ni",
          "particle": "に",
          "romaji": "ni",
          "function": "Địa điểm đến / Thời gian / Người nhận",
          "color": "#a78bfa",
          "detail": "に có 3 chức năng chính: (1) chỉ điểm đến của chuyển động, (2) chỉ thời điểm cụ thể, (3) chỉ người nhận.",
          "examples": [
            {
              "jp": "がっこう<に>いきます。",
              "romaji": "Gakkō <ni> ikimasu.",
              "vn": "Đi đến trường.",
              "highlight": "に"
            },
            {
              "jp": "3じ<に>あいましょう。",
              "romaji": "Sanji <ni> aimashou.",
              "vn": "Hãy gặp nhau lúc 3 giờ.",
              "highlight": "に"
            }
          ]
        },
        {
          "id": "p_de",
          "particle": "で",
          "romaji": "de",
          "function": "Địa điểm hành động / Phương tiện / Nguyên liệu",
          "color": "#fb923c",
          "detail": "で chỉ nơi diễn ra hành động (khác với に chỉ điểm đến). Cũng dùng để chỉ phương tiện di chuyển hoặc phương pháp.",
          "examples": [
            {
              "jp": "としょかん<で>べんきょうします。",
              "romaji": "Toshokan <de> benkyō shimasu.",
              "vn": "Học ở thư viện.",
              "highlight": "で"
            },
            {
              "jp": "バス<で>きました。",
              "romaji": "Basu <de> kimashita.",
              "vn": "Đi bằng xe buýt đến.",
              "highlight": "で"
            }
          ]
        },
        {
          "id": "p_no",
          "particle": "の",
          "romaji": "no",
          "function": "Sở hữu / Liên kết danh từ",
          "color": "#22d3ee",
          "detail": "の liên kết hai danh từ, thể hiện sở hữu hoặc mối quan hệ. Danh từ trước の bổ nghĩa cho danh từ sau.",
          "examples": [
            {
              "jp": "わたし<の>ほん",
              "romaji": "Watashi <no> hon",
              "vn": "Sách của tôi",
              "highlight": "の"
            },
            {
              "jp": "にほん<の>りょうり",
              "romaji": "Nihon <no> ryōri",
              "vn": "Ẩm thực Nhật Bản",
              "highlight": "の"
            }
          ]
        },
        {
          "id": "p_he",
          "particle": "へ",
          "romaji": "he",
          "function": "Hướng tới / Đến",
          "color": "#38bdf8",
          "detail": "へ dùng để chỉ hướng đi, điểm đến hoặc hướng chuyển động. Phát âm giống に trong nhiều trường hợp.",
          "examples": [
            {
              "jp": "がっこう<へ>いきます。",
              "romaji": "Gakkō <he> ikimasu.",
              "vn": "Tôi đi đến trường.",
              "highlight": "へ"
            },
            {
              "jp": "ともだち<へ>てがみをかきます。",
              "romaji": "Tomodachi <he> tegami o kakimasu.",
              "vn": "Viết thư cho bạn.",
              "highlight": "へ"
            }
          ]
        },
        {
          "id": "p_to",
          "particle": "と",
          "romaji": "to",
          "function": "Và / Cùng với",
          "color": "#f472b6",
          "detail": "と dùng để liệt kê (A と B = A và B) hoặc chỉ người đồng hành (〜と いく = đi cùng với ~).",
          "examples": [
            {
              "jp": "ともだち<と>いきます。",
              "romaji": "Tomodachi <to> ikimasu.",
              "vn": "Đi cùng bạn bè.",
              "highlight": "と"
            },
            {
              "jp": "パン<と>たまご",
              "romaji": "Pan <to> tamago",
              "vn": "Bánh mì và trứng",
              "highlight": "と"
            }
          ]
        },
        {
          "id": "p_mo",
          "particle": "も",
          "romaji": "mo",
          "function": "Cũng",
          "color": "#86efac",
          "detail": "も thay thế は hoặc が để diễn đạt 'cũng'. Thêm thông tin tương tự vào chủ đề đã nói.",
          "examples": [
            {
              "jp": "わたし<も>いきます。",
              "romaji": "Watashi <mo> ikimasu.",
              "vn": "Tôi cũng đi.",
              "highlight": "も"
            },
            {
              "jp": "これ<も>おいしいです。",
              "romaji": "Kore <mo> oishii desu.",
              "vn": "Cái này cũng ngon.",
              "highlight": "も"
            }
          ]
        },
        {
          "id": "p_ka",
          "particle": "か",
          "romaji": "ka",
          "function": "Dấu hỏi (cuối câu)",
          "color": "#cbd5e1",
          "detail": "か đặt cuối câu để biến câu thành câu hỏi. Không cần đảo vị trí chủ ngữ như tiếng Anh.",
          "examples": [
            {
              "jp": "これはなんです<か>？",
              "romaji": "Kore wa nan desu <ka>?",
              "vn": "Cái này là gì?",
              "highlight": "か"
            },
            {
              "jp": "いきます<か>？",
              "romaji": "Ikimasu <ka>?",
              "vn": "Bạn có đi không?",
              "highlight": "か"
            }
          ]
        },
        {
          "id": "p_kara",
          "particle": "から",
          "romaji": "kara",
          "function": "Từ / Bắt đầu từ / Vì (nguyên nhân)",
          "color": "#f97316",
          "detail": "から có 2 chức năng chính: (1) chỉ điểm xuất phát về không gian hoặc thời gian (từ ~), (2) chỉ nguyên nhân/lý do (vì ~). Thường đi kèm với まで để diễn đạt 'từ ~ đến ~'.",
          "examples": [
            {
              "jp": "とうきょう<から>きました。",
              "romaji": "Tōkyō <kara> kimashita.",
              "vn": "Tôi đến từ Tokyo.",
              "highlight": "から"
            },
            {
              "jp": "9じ<から>べんきょうします。",
              "romaji": "Kuji <kara> benkyō shimasu.",
              "vn": "Học từ 9 giờ.",
              "highlight": "から"
            }
          ]
        },
        {
          "id": "p_made",
          "particle": "まで",
          "romaji": "made",
          "function": "Đến / Cho đến (giới hạn)",
          "color": "#e879f9",
          "detail": "まで chỉ giới hạn cuối cùng về không gian hoặc thời gian. Thường dùng cặp から〜まで (từ ~ đến ~).",
          "examples": [
            {
              "jp": "えき<まで>あるきます。",
              "romaji": "Eki <made> arukimasu.",
              "vn": "Đi bộ đến ga.",
              "highlight": "まで"
            },
            {
              "jp": "6じ<まで>はたらきます。",
              "romaji": "Rokuji <made> hatarakimasu.",
              "vn": "Làm việc đến 6 giờ.",
              "highlight": "まで"
            }
          ]
        },
        {
          "id": "p_ya",
          "particle": "や",
          "romaji": "ya",
          "function": "Và (liệt kê không đầy đủ)",
          "color": "#4ade80",
          "detail": "や dùng để liệt kê một số ví dụ trong danh sách, ám chỉ còn nhiều thứ khác nữa (khác với と liệt kê đầy đủ). Thường đi kèm với など (vân vân).",
          "examples": [
            {
              "jp": "パン<や>たまごをかいました。",
              "romaji": "Pan <ya> tamago o kaimashita.",
              "vn": "Đã mua bánh mì, trứng (và các thứ khác).",
              "highlight": "や"
            },
            {
              "jp": "にほんご<や>えいごをならいます。",
              "romaji": "Nihongo <ya> eigo o naraimasu.",
              "vn": "Học tiếng Nhật, tiếng Anh (và các thứ khác).",
              "highlight": "や"
            }
          ]
        },
        {
          "id": "p_yo",
          "particle": "よ",
          "romaji": "yo",
          "function": "Khẳng định / Thông báo (cuối câu)",
          "color": "#fbbf24",
          "detail": "よ đặt cuối câu để nhấn mạnh thông tin mới hoặc khẳng định điều người nghe chưa biết. Mang nghĩa 'đấy', 'nhé', 'đó'.",
          "examples": [
            {
              "jp": "これはおいしい<よ>。",
              "romaji": "Kore wa oishii <yo>.",
              "vn": "Cái này ngon đấy!",
              "highlight": "よ"
            },
            {
              "jp": "もうすぐきます<よ>。",
              "romaji": "Mōsugu kimasu <yo>.",
              "vn": "Sắp đến rồi đó.",
              "highlight": "よ"
            }
          ]
        },
        {
          "id": "p_ne",
          "particle": "ね",
          "romaji": "ne",
          "function": "Xác nhận / Đồng thuận (cuối câu)",
          "color": "#67e8f9",
          "detail": "ね đặt cuối câu để tìm kiếm sự đồng ý hoặc xác nhận từ người nghe, tương đương 'phải không?', 'nhỉ?', 'nhé?'. Tạo cảm giác gần gũi trong hội thoại.",
          "examples": [
            {
              "jp": "いいてんきです<ね>。",
              "romaji": "Ii tenki desu <ne>.",
              "vn": "Thời tiết đẹp nhỉ.",
              "highlight": "ね"
            },
            {
              "jp": "むずかしい<ね>。",
              "romaji": "Muzukashii <ne>.",
              "vn": "Khó nhỉ?",
              "highlight": "ね"
            }
          ]
        }
      ]
    },
