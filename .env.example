# Sao chép thành .env.local rồi điền giá trị từ Firebase Console →
# Project settings → Your apps → Web app → firebaseConfig.
# Bỏ trống (hoặc không có file) thì tính năng đăng nhập/đồng bộ tự ẩn,
# app chạy hoàn toàn offline như trước.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dev: đặt 1 để nối tới Firebase Emulator (npm run emulators) thay vì project thật.
# VITE_USE_EMULATOR=1
